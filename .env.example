# Copy this file to .env and replace every placeholder before starting Lumia.

# Password of this app's role on Luna Sentia's shared PostgreSQL (luna-sentia-db).
# Must equal LUNALUMIA_DB_PASSWORD in Luna_Sentia/.env.
POSTGRES_PASSWORD=lunalumia-dev

# Private UI-to-backend credential. This is not issued by any service: make up your own
# random value of at least 32 characters, e.g. with `openssl rand -hex 32`.
# The default works on localhost; set your own before giving this app a public (https)
# address, and the same value as LUNALUMIA_API_TOKEN in Luna_Sentia/.env.
# LUNALUMIA_API_TOKEN=lunalumia-dev-token-for-localhost-only

# Who may use this app, among the people Luna Sentia lets sign in: blank (the default) for
# Sentia's owner only, * for all of them, or a comma-separated list. The owner always may.
# LUNALUMIA_ALLOWED_EMAILS=*

# Public origin of the MCP server, used for its icon URLs.
# Must be HTTPS when exposed publicly; plain HTTP is accepted only on localhost.
MCP_PUBLIC_URL=http://localhost:18002
# The address people open this app's web UI at; the get_ui_link MCP tool gives it out.
UI_PUBLIC_URL=http://localhost:18502

# Single sign-on through Luna Sentia: the auth service's public address (SENTIA_AUTH_PUBLIC_URL
# in Luna_Sentia/.env), and its address on luna_sentia_network; https://auth.example.com
# with a tunnel.
LUNA_SSO_URL=http://localhost:19001
LUNA_SSO_INTERNAL_URL=http://luna-sentia-auth:8000

# Luna Vibia, for music schemes: the lights follow the mood of the track Vibia plays.
# Use the same LUNAVIBIA_API_TOKEN as in Luna_Vibia/.env (the default matches Vibia's default).
LUNAVIBIA_API_URL=http://luna-vibia-mcp:8000
# LUNAVIBIA_API_TOKEN=lunavibia-dev-token-for-localhost-only

# Luna Visia, where room and light pictures live: Lumia tags each Visia image it shows
# "luna lumia". Use the same LUNAVISIA_COMPANION_TOKEN as in Luna_Visia/.env; leave it
# blank to skip tagging.
LUNAVISIA_API_URL=http://luna-visia-mcp:8000
LUNAVISIA_COMPANION_TOKEN=

# iCUE bridges, for Corsair devices. bridge/install.ps1 prints each PC's token. Prefer one
# token per PC, so one PC's token cannot drive another; LUNALUMIA_ICUE_TOKEN is used for any
# PC not listed. Leave both blank if you have no iCUE lights.
LUNALUMIA_ICUE_TOKENS=
# LUNALUMIA_ICUE_TOKENS=192.168.1.15=token-of-that-pc,192.168.1.20=token-of-that-pc
LUNALUMIA_ICUE_TOKEN=
