# Copy this file to .env and replace every placeholder before starting Lumia.

# Password of this app's role on Luna Sentia's shared PostgreSQL (luna-sentia-db).
# Must equal LUNALUMIA_DB_PASSWORD in Luna_Sentia/.env.
POSTGRES_PASSWORD=lunalumia-dev

# Private UI-to-backend credential. This is not issued by any service: make up your own
# random value of at least 32 characters, e.g. with `openssl rand -hex 32`.
LUNALUMIA_API_TOKEN=replace-with-a-private-random-value-of-at-least-32-characters

# Comma-separated, verified Google accounts allowed to use the Streamlit UI.
LUNALUMIA_ALLOWED_EMAILS=you@example.com

# Public origin of the MCP server, used for its icon URLs.
# Must be HTTPS when exposed publicly; plain HTTP is accepted only on localhost.
MCP_PUBLIC_URL=http://localhost:18002

# Single sign-on through Luna Sentia: the auth service's public address (SENTIA_AUTH_PUBLIC_URL
# in Luna_Sentia/.env), and its address on luna_sentia_network.
LUNA_SSO_URL=https://auth.example.com
LUNA_SSO_INTERNAL_URL=http://luna-sentia-auth:8000
